{
  auto_https disable_redirects
}

{$TUNNEL_HOSTNAME} {
  tls {
    dns cloudflare {$CF_DNS_API_TOKEN}
  }

  log {
    output file /var/log/caddy/access.log {
      roll_size 10MiB
      roll_keep 10
      roll_keep_for 2160h
    }
    format json
  }

  # The tunnel only ever reaches the server, which serves the built frontend.
  # Do NOT add a route to the Vite dev server (frontend:5173): the dev server
  # exposes arbitrary repo files via /@fs/ and has no auth of its own.
  reverse_proxy server:3111
}
