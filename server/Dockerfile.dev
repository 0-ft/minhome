# Dev image for the server.
#
# docker-compose.dev.yml mounts the repo and runs `pnpm dev`, so this image
# carries no source -- only the things a bare node:22-slim lacks. It exists
# because display rendering needs Chromium, and the dev overlay would otherwise
# run on stock node:22-slim and fail to render while production worked.
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium fonts-liberation ca-certificates \
      fontconfig fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
ENV CHROMIUM_PATH=/usr/bin/chromium

# The framework stylesheet references fonts at an absolute /fonts/ path. The repo
# is mounted at /app, so this resolves once the container is running.
RUN ln -s /app/server/vendor/trmnl-framework/fonts /fonts

RUN corepack enable && corepack prepare pnpm@10 --activate
WORKDIR /app
